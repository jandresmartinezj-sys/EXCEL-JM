# Copia a .env y ajusta. NUNCA subas .env al repositorio.
JARVIZ_DB_PATH=data/jarviz.db
# Clave opcional: sin ella JARVIZ funciona en modo local (reglas), sin LLM.
ANTHROPIC_API_KEY=
JARVIZ_MODEL=claude-opus-5-5
# Nivel máximo de autonomía global (1-5). Solo el propietario puede cambiarlo.
JARVIZ_MAX_AUTONOMY=3
# Duración de sesión (horas)
JARVIZ_SESSION_HOURS=12
# Retención de memoria de conversación (días)
JARVIZ_CONVERSATION_RETENTION_DAYS=30
# Orígenes permitidos (CORS), separados por coma. Vacío = solo mismo origen.
JARVIZ_ALLOWED_ORIGINS=
